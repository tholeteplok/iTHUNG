rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Koleksi Pemetaan Username Unik
    // Setiap pemain bisa membaca ketersediaan username.
    // Pembuatan/update username hanya boleh jika UID cocok dengan user yang login.
    match /usernames/{username} {
      allow read: if true;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // 2. Profil Pemain & Papan Peringkat All-Time
    match /profiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. Hasil Tantangan Harian (Papan Peringkat Harian)
    match /daily_challenge_results/{resultId} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }

    // 4. Papan Peringkat Tantangan Khusus (Speed Blitz & Math Marathon)
    match /challenge_leaderboards/{boardId}/entries/{entryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
